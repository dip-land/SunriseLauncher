{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Sunrise Launcher",
  "version": "0.1.0",
  "identifier": "io.github.stanuwu.sunrise-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Project Sunrise Launcher",
        "width": 1180,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "backgroundColor": "#090b11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Installer and launcher for Project Sunrise",
    "longDescription": "Downloads the owned Destiny 2 depots required by Project Sunrise, installs verified Sunrise releases, and manages repairs and updates.",
    "copyright": "Copyright © 2026 Project Sunrise contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
